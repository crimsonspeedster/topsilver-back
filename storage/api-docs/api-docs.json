        "/api/v1/integrations/1c/users": {
            "get": {
                "tags": [
                    "users"
                ],
                "summary": "Get users",
                "description": "Get users from site",
                "operationId": "c8a850b92ea126fa97fdf83915c5202c",
                "parameters": [
                    {
                        "name": "updated_from",
                        "in": "query",
                        "description": "Filter users updated after datetime (UTC, ISO 8601)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "example": "2026-06-12T09:25:00Z"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Pagination page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        },
                        "example": 1
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page (max 500)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 100
                        },
                        "example": 100
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "users": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/UserItem"
                                            }
                                        },
                                        "pagination": {
                                            "$ref": "#/components/schemas/PaginationItem"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
