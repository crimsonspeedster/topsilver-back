                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "title": {
                        "type": "string",
                        "example": "1+1=3"
                    },
                    "description": {
                        "type": "string",
                        "example": "При покупке 2х товаров получи 3й в подарок",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "C1ShopItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "city_code": {
                        "type": "string",
                        "example": "ua-kiyivska-oblast-kiyiv"
                    },
                    "title": {
                        "type": "string",
                        "example": "АТБ Київ Хрещатик"
                    },
                    "short_description": {
                        "type": "string",
                        "example": "Продуктовий супермаркет",
                        "nullable": true
                    },
                    "address": {
                        "type": "string",
                        "example": "вул. Хрещатик, 10"
                    },
                    "address_link": {
                        "type": "string",
                        "example": "https://maps.google.com/?q=50.45,30.52"
                    },
                    "phone": {
                        "type": "string",
                        "example": "380630000000"
                    },
                    "time_working": {
                        "type": "string",
                        "example": "08:00-22:00"
                    }
                },
                "type": "object"
            },
            "C1EntityDeleteRequest": {
                "required": [
                    "ids"
                ],
                "properties": {
                    "ids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "example": "1c_test-1"
                        },
                        "example": [
                            "1c_test-2",
                            "1c_test",
                            "1c_test-1"
                        ]
                    }
                },
                "type": "object"
            }
        },
