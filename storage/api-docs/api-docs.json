    "components": {
        "schemas": {
            "C1CategoryItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "title": {
                        "type": "string",
                        "example": "Ноутбуки"
                    },
                    "description": {
                        "type": "string",
