    "components": {
        "schemas": {
            "C1AttributeItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_test_1"
                    },
                    "title": {
                        "type": "string",
                        "example": "Size"
                    },
                    "type": {
                        "type": "string",
                        "example": "text",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "C1AttributeTermItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_test_1"
                    },
                    "title": {
                        "type": "string",
                        "example": "xl"
                    },
                    "meta_value": {
                        "type": "string",
                        "example": "XL",
                        "nullable": true
                    },
                    "attribute_id": {
                        "type": "string",
                        "example": "1c_attr_1"
                    }
                },
                "type": "object"
            },
            "C1BonusElement": {
                "properties": {
                    "amount": {
                        "type": "integer",
                        "example": 1500
                    },
                    "accrual_from": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-06-12"
                    },
                    "available_from": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-06-15"
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-12-31"
                    }
                },
                "type": "object"
            },
            "C1BonusItem": {
                "properties": {
                    "phone": {
                        "type": "string",
                        "example": "380630000000"
                    },
                    "bonuses": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/C1BonusElement"
                        }
                    }
                },
                "type": "object"
            },
            "C1CategoryItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "title": {
                        "type": "string",
                        "example": "Ноутбуки"
                    },
                    "description": {
                        "type": "string",
                        "example": "Все ноутбуки",
                        "nullable": true
                    },
                    "parent_id": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "C1CertificateItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_test_1"
                    },
                    "code": {
                        "type": "string",
                        "example": "QWERTYUIOPASDFG"
                    },
                    "value": {
                        "type": "number",
                        "format": "float",
                        "example": 5000
                    },
                    "activated_at": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-06-12",
                        "nullable": true
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-09-31",
                        "nullable": true
                    },
                    "is_used": {
                        "type": "boolean",
                        "example": false
                    }
                },
                "type": "object"
            },
            "C1CollectionItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "title": {
                        "type": "string",
                        "example": "Коллекция"
                    },
                    "description": {
                        "type": "string",
                        "example": "Описание коллекции",
                        "nullable": true
                    },
                    "parent_id": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "C1CouponItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_test_1"
                    },
                    "code": {
                        "type": "string",
                        "example": "QWERTYUIOPASDFG"
                    },
                    "type": {
                        "type": "string",
                        "example": "percent"
                    },
                    "value": {
                        "type": "integer",
                        "example": 100
                    },
                    "starts_at": {
                        "type": "string",
                        "example": "2026-06-12T00:00:00Z",
                        "nullable": true
                    },
                    "expires_at": {
                        "type": "string",
                        "example": "2026-06-21T00:00:00Z",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": false,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "C1DeleteElementItem": {
                "properties": {
                    "total_requested": {
                        "type": "integer",
                        "example": 3
                    },
                    "deleted": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "1c_test_id",
                            "1c_test_id_2"
                        ]
                    },
                    "not_found": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "1c_test_id_3"
                        ]
                    }
                },
                "type": "object"
            },
            "C1PromotionItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "title": {
                        "type": "string",
                        "example": "1+1=3"
                    },
                    "description": {
                        "type": "string",
                        "example": "При покупке 2х товаров получи 3й в подарок",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "C1ShopItem": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "1c_1001"
                    },
                    "city_code": {
                        "type": "string",
                        "example": "ua-kiyivska-oblast-kiyiv"
                    },
                    "title": {
                        "type": "string",
                        "example": "АТБ Київ Хрещатик"
                    },
                    "short_description": {
                        "type": "string",
                        "example": "Продуктовий супермаркет",
                        "nullable": true
                    },
                    "address": {
                        "type": "string",
                        "example": "вул. Хрещатик, 10"
                    },
                    "address_link": {
                        "type": "string",
                        "example": "https://maps.google.com/?q=50.45,30.52"
                    },
                    "phone": {
                        "type": "string",
                        "example": "380630000000"
                    },
                    "time_working": {
                        "type": "string",
                        "example": "08:00-22:00"
                    }
                },
                "type": "object"
            },
            "C1EntityDeleteRequest": {
                "required": [
                    "ids"
                ],
                "properties": {
                    "ids": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "example": "1c_test-1"
                        },
                        "example": [
                            "1c_test-2",
                            "1c_test",
                            "1c_test-1"
                        ]
                    }
                },
                "type": "object"
            },
            "PaginationItem": {
                "properties": {
                    "total_items": {
                        "type": "integer",
                        "example": 50
                    },
                    "total_pages": {
                        "type": "integer",
                        "example": 1
                    },
                    "current_page": {
                        "type": "integer",
                        "example": 1
